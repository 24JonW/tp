<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="8" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <Label fx:id="listHeading" styleClass="list-heading" wrapText="true" minHeight="-Infinity" maxWidth="Infinity" />
  <GridPane hgap="16" styleClass="contact-column-header">
    <columnConstraints>
      <ColumnConstraints percentWidth="22" />
      <ColumnConstraints percentWidth="15" />
      <ColumnConstraints percentWidth="28" />
      <ColumnConstraints percentWidth="20" />
      <ColumnConstraints percentWidth="15" />
    </columnConstraints>
    <Label text="Contact" GridPane.columnIndex="0" />
    <Label text="Phone" GridPane.columnIndex="1" />
    <Label text="Email" GridPane.columnIndex="2" />
    <Label text="Event type" GridPane.columnIndex="3" />
    <Label text="Event date" GridPane.columnIndex="4" />
  </GridPane>
  <ListView fx:id="personListView" VBox.vgrow="ALWAYS">
    <placeholder>
      <Label styleClass="label-bright" text="No contacts to display" />
    </placeholder>
  </ListView>
</VBox>
