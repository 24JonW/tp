@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

Package Model as ModelPackage <<Rectangle>>{
Class "<<interface>>\nReadOnlyAddressBook" as ReadOnlyAddressBook
Class "<<interface>>\nReadOnlyUserPrefs" as ReadOnlyUserPrefs
Class "<<interface>>\nModel" as Model
Class AddressBook
Class ModelManager
Class UserPrefs

Class UniquePersonList
Class Person
Class Email
Class EventDate
Class EventType
Class Name
Class Phone
Class Stage

Class I #FFFFFF
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Model

Package "JavaFX collections" as JavaFxPackage <<Rectangle>> {
Class "<<interface>>\nObservableList" as ObservablePersonList
Class "FilteredList" as FilteredPersonList
Class "SortedList" as SortedPersonList
}

AddressBook .up.|> ReadOnlyAddressBook

ModelManager .up.|> Model
Model .right.> ReadOnlyUserPrefs
Model .left.> ReadOnlyAddressBook
ModelManager -left-> "1" AddressBook
ModelManager -right-> "1" UserPrefs
UserPrefs .up.|> ReadOnlyUserPrefs

AddressBook *--> "1" UniquePersonList
UniquePersonList --> "~* all" Person
Person *--> Name
Person *--> Phone
Person *--> Email
Person *--> EventType
Person *--> EventDate
Person *--> Stage

Person -[hidden]up--> I
UniquePersonList -[hidden]right-> I

Name -[hidden]right-> Phone
Phone -[hidden]right-> Email
Email -[hidden]right-> EventType
EventType -[hidden]right-> EventDate
EventDate -[hidden]right-> Stage

ModelManager -right-> "1" FilteredPersonList : filteredPersons
ModelManager -right-> "1" SortedPersonList : displayedPersons
UniquePersonList -right-> "1" ObservablePersonList : exposes insertion order
FilteredPersonList -up-> "1" ObservablePersonList : source
SortedPersonList -up-> "1" FilteredPersonList : source

note bottom of SortedPersonList
  All collection elements are Person instances.
  Display order may differ from saved insertion order.
  Equal event dates retain insertion order.
end note
@enduml
