<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<HBox id="cardPane" fx:id="cardPane" minWidth="0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1">
  <GridPane alignment="CENTER_LEFT" hgap="16" minWidth="0"
            maxWidth="Infinity" minHeight="62" HBox.hgrow="ALWAYS">
    <padding>
      <Insets top="10" right="12" bottom="10" left="12" />
    </padding>
    <columnConstraints>
      <ColumnConstraints percentWidth="22" />
      <ColumnConstraints percentWidth="14" />
      <ColumnConstraints percentWidth="24" />
      <ColumnConstraints percentWidth="14" />
      <ColumnConstraints percentWidth="13" />
      <ColumnConstraints percentWidth="13" />
    </columnConstraints>

    <HBox alignment="CENTER_LEFT" spacing="6" minWidth="0"
          maxWidth="Infinity" GridPane.columnIndex="0">
      <Label fx:id="id" styleClass="cell_big_label">
        <minWidth>
          <!-- Keeps the displayed index readable. -->
          <Region fx:constant="USE_PREF_SIZE" />
        </minWidth>
      </Label>
      <Label fx:id="name" minWidth="0" maxWidth="Infinity"
             textOverrun="ELLIPSIS" styleClass="cell_big_label"
             HBox.hgrow="ALWAYS" />
    </HBox>

    <Label fx:id="phone" minWidth="0" maxWidth="Infinity"
           textOverrun="ELLIPSIS" styleClass="contact-phone"
           GridPane.columnIndex="1" />
    <Label fx:id="email" minWidth="0" maxWidth="Infinity"
           textOverrun="ELLIPSIS" styleClass="contact-email"
           GridPane.columnIndex="2" />
    <Label fx:id="eventType" minWidth="0" maxWidth="Infinity"
           textOverrun="ELLIPSIS" styleClass="contact-event-type"
           GridPane.columnIndex="3" />
    <Label fx:id="stage" minWidth="0" maxWidth="Infinity"
           textOverrun="ELLIPSIS" styleClass="cell_small_label"
           GridPane.columnIndex="4" />
    <Label fx:id="eventDate" minWidth="0" maxWidth="Infinity"
           textOverrun="ELLIPSIS" styleClass="contact-event-date"
           GridPane.columnIndex="5" />
  </GridPane>
</HBox>
