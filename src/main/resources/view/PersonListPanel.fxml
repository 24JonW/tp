<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="8" minWidth="0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <Label fx:id="listHeading" styleClass="list-heading" wrapText="true" minHeight="-Infinity" maxWidth="Infinity" />
  <GridPane fx:id="columnHeader" id="columnHeader"
            hgap="16" minWidth="0" maxWidth="-Infinity"
            styleClass="contact-column-header">
    <columnConstraints>
      <ColumnConstraints percentWidth="22" />
      <ColumnConstraints percentWidth="14" />
      <ColumnConstraints percentWidth="24" />
      <ColumnConstraints percentWidth="14" />
      <ColumnConstraints percentWidth="13" />
      <ColumnConstraints percentWidth="13" />
    </columnConstraints>
    <Label text="Contact" minWidth="0" maxWidth="Infinity"
           wrapText="true" GridPane.columnIndex="0" />
    <Label text="Phone" minWidth="0" maxWidth="Infinity"
           wrapText="true" GridPane.columnIndex="1" />
    <Label text="Email" minWidth="0" maxWidth="Infinity"
           wrapText="true" GridPane.columnIndex="2" />
    <Label text="Event type" minWidth="0" maxWidth="Infinity"
           wrapText="true" GridPane.columnIndex="3" />
    <Label text="Event stage" minWidth="0" maxWidth="Infinity"
           wrapText="true" GridPane.columnIndex="4" />
    <Label text="Event date" minWidth="0" maxWidth="Infinity"
           wrapText="true" GridPane.columnIndex="5" />
  </GridPane>
  <ListView fx:id="personListView" minWidth="0"
            styleClass="engagement-list" VBox.vgrow="ALWAYS">
    <placeholder>
      <Label styleClass="label-bright" text="No contacts to display" />
    </placeholder>
  </ListView>
</VBox>
