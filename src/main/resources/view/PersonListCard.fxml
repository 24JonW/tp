<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<HBox id="cardPane" fx:id="cardPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <GridPane alignment="CENTER_LEFT" hgap="16" maxWidth="1.7976931348623157E308" minHeight="62"
            HBox.hgrow="ALWAYS">
    <padding>
      <Insets top="10" right="12" bottom="10" left="12" />
    </padding>
    <columnConstraints>
      <ColumnConstraints percentWidth="22" />
      <ColumnConstraints percentWidth="15" />
      <ColumnConstraints percentWidth="28" />
      <ColumnConstraints percentWidth="20" />
      <ColumnConstraints percentWidth="15" />
    </columnConstraints>
    <HBox alignment="CENTER_LEFT" spacing="6" GridPane.columnIndex="0">
      <Label fx:id="id" styleClass="cell_big_label">
        <minWidth>
          <!-- Ensures that the label text is never truncated -->
          <Region fx:constant="USE_PREF_SIZE" />
        </minWidth>
      </Label>
      <Label fx:id="name" maxWidth="1.7976931348623157E308" styleClass="cell_big_label" text="\$first"
             HBox.hgrow="ALWAYS" />
    </HBox>
    <Label fx:id="phone" styleClass="contact-phone" text="\$phone" GridPane.columnIndex="1" />
    <Label fx:id="email" styleClass="contact-email" text="\$email" GridPane.columnIndex="2" />
    <Label fx:id="eventType" styleClass="contact-event-type" text="\$eventType" GridPane.columnIndex="3" />
    <Label fx:id="eventDate" styleClass="contact-event-date" text="\$eventDate" GridPane.columnIndex="4" />
  </GridPane>
</HBox>
