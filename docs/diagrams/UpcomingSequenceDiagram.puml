@startuml
!include style.puml
skinparam ArrowFontStyle plain
hide footbox

participant ":MainWindow" as ui UI_COLOR
participant ":LogicManager" as logic LOGIC_COLOR
participant "command:UpcomingCommand" as command LOGIC_COLOR
participant ":ModelManager" as model MODEL_COLOR

ui -> logic : execute("upcoming")
activate logic
ref over logic
  Parse input into UpcomingCommand
  (parser interactions omitted)
end ref
logic -> command : execute(model)
activate command
note right of command
  Calculate startDate using the local clock.
  endDate = startDate.plusDays(6).
end note
command -> model : showUpcomingPersons(startDate, endDate)
activate model
note over command, model
  Replace the filter over all saved engagements.
  Include both date boundaries.
  Sort by event date with insertion-order ties.
end note
model --> command
deactivate model
command -> model : getFilteredPersonList()
activate model
model --> command : displayedPersons
deactivate model
command --> logic : CommandResult(feedback)
deactivate command
note right of logic : Skip storage writes for UpcomingCommand.
logic --> ui : commandResult
deactivate logic
ui -> logic : getPersonListHeading()
activate logic
logic -> model : getPersonListHeading()
activate model
model --> logic : heading with dates and count
deactivate model
logic --> ui : heading
deactivate logic
note over ui, model
  Display feedback and the upcoming heading.
  List changes update the observed cards.
end note
@enduml
