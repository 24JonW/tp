@startuml
!include style.puml
skinparam ArrowFontStyle plain

Actor User as user USER_COLOR
Participant ":UI" as ui UI_COLOR
Participant ":Logic" as logic LOGIC_COLOR
Participant ":Model" as model MODEL_COLOR
Participant ":Storage" as storage STORAGE_COLOR
Participant "addressbook.json" as file #grey

user -[USER_COLOR]> ui : "delete 1"
activate ui UI_COLOR

ui -[UI_COLOR]> logic : execute("delete 1")
activate logic LOGIC_COLOR

logic -[LOGIC_COLOR]> model : deletePerson(p)
activate model MODEL_COLOR

model -[MODEL_COLOR]-> logic
deactivate model

logic -[LOGIC_COLOR]> storage : saveAddressBook(addressBook)
activate storage STORAGE_COLOR

storage -[STORAGE_COLOR]> file : write JSON data
activate file #grey
file --[#grey]> storage
deactivate file

storage --[STORAGE_COLOR]> logic
deactivate storage

logic --[LOGIC_COLOR]> ui : commandResult
deactivate logic

ui -[UI_COLOR]> logic : getPersonListHeading()
activate logic LOGIC_COLOR

logic -[LOGIC_COLOR]> model : getPersonListHeading()
activate model MODEL_COLOR
model --[MODEL_COLOR]> logic : heading
deactivate model

logic --[LOGIC_COLOR]> ui : heading
deactivate logic

ui --[UI_COLOR]> user : show updated list and feedback
deactivate ui
@enduml
