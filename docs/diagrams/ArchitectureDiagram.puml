@startuml
!include <office/Concepts/documents>
!include <office/Users/user>
!include style.puml
!pragma layout smetana

top to bottom direction

Package "ShutterLink" <<Rectangle>> {
    Class Main #grey
    together {
        Class UI UI_COLOR
        Class Logic LOGIC_COLOR
        Class Storage STORAGE_COLOR
    }
    Class Model MODEL_COLOR
    Class Commons LOGIC_COLOR_T2
}

Class "<$user>\nUser" as User MODEL_COLOR_T2
Class "<$documents>\nJSON files" as Files UI_COLOR_T1

User ..> UI : enters commands

Main -[#grey]-> UI
Main -[#grey]-> Logic
Main -[#grey]-> Model
Main -[#grey]-> Storage

UI -[#green]> Logic : commands
UI -right[#green]-> Model : observes data
Logic -[#blue]-> Model : reads and updates
Logic -[#blue]-> Storage : saves data
Storage -[STORAGE_COLOR].> Model : converts data
Storage .right[STORAGE_COLOR].> Files : reads/writes

note bottom of Commons
    Utilities shared by
    other components
end note
@enduml
