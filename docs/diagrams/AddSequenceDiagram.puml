@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant "a:AddCommand" as AddCommand LOGIC_COLOR
participant "<<class>>\nSimilarContactWarning" as SimilarContactWarning LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

box Storage STORAGE_COLOR_T1
participant "s:Storage" as Storage STORAGE_COLOR
end box

[-> LogicManager : execute("add ...")
activate LogicManager

note right of LogicManager : parsing into a:AddCommand is\nsimilar to the delete example above

LogicManager -> AddCommand : execute(m)
activate AddCommand

AddCommand -> Model : hasPerson(toAdd)
activate Model
Model --> AddCommand : isDuplicate
deactivate Model

alt isDuplicate
    AddCommand --> LogicManager : CommandException
    [<-- LogicManager : CommandException
else else
    AddCommand -> Model : addPerson(toAdd)
    activate Model
    Model --> AddCommand
    deactivate Model

    AddCommand -> Model : updateFilteredPersonList(PREDICATE_SHOW_ALL_PERSONS)
    activate Model
    Model --> AddCommand
    deactivate Model

    AddCommand -> Model : getFilteredPersonList()
    activate Model
    Model --> AddCommand : displayedPersons
    deactivate Model

    AddCommand -> SimilarContactWarning : generate(displayedPersons, toAdd)
    activate SimilarContactWarning
    SimilarContactWarning --> AddCommand : warning
    deactivate SimilarContactWarning

    create CommandResult
    AddCommand -> CommandResult
    activate CommandResult
    CommandResult --> AddCommand
    deactivate CommandResult

    AddCommand --> LogicManager : r
    deactivate AddCommand

    LogicManager -> Storage : saveAddressBook(addressBook)
    activate Storage
    Storage --> LogicManager
    deactivate Storage

    [<-- LogicManager : r
end
deactivate LogicManager
@enduml
